def fig4_gbm_expression_pca(
    standardized_expression: pd.DataFrame,
    merged_cohort: pd.DataFrame,
    output_dir: Path,
    dpi: int,
    overwrite: bool,
) -> Path:
    """Figure 4: PCA of standardized RNA-expression values."""
    matrix = standardized_expression.to_numpy(dtype=float)
    if PCA is not None:
        pca = PCA(n_components=2, random_state=42)
        components = pca.fit_transform(matrix)
        explained_var = pca.explained_variance_ratio_
    else:
        centered = matrix - matrix.mean(axis=0)
        _, _, vh = np.linalg.svd(centered, full_matrices=False)
        components = centered @ vh.T[:, :2]
        explained_var = np.array([np.var(components[:, 0]), np.var(components[:, 1])]) / max(np.var(centered), 1e-8)

    plot_df = pd.DataFrame({"PC1": components[:, 0], "PC2": components[:, 1], "SUBTYPE": merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"].tolist()}, index=merged_cohort["SAMPLE_ID"])
    fig, ax = plt.subplots(figsize=(7, 6))

    legend_handles = []
    for subtype in ["Proneural", "Classical", "Mesenchymal", "Mixed/Ambiguous"]:
        subset = plot_df[plot_df["SUBTYPE"] == subtype]
        if subset.empty:
            continue
        color = DEFAULT_PALETTE.get(subtype, "#777777")
        if subtype == "Mixed/Ambiguous":
            handle = ax.scatter(subset["PC1"], subset["PC2"], c=color, alpha=0.7, s=45, marker="o", label=subtype)
            ax.scatter(subset["PC1"], subset["PC2"], c="black", alpha=0.9, s=20, marker="x")
        else:
            handle = ax.scatter(subset["PC1"], subset["PC2"], c=color, alpha=0.7, s=45, label=subtype)
        legend_handles.append(handle)

    ax.set_xlabel(f"PC1 ({explained_var[0] * 100:.1f}% variance)")
    ax.set_ylabel(f"PC2 ({explained_var[1] * 100:.1f}% variance)")
    ax.set_title("PCA of synthetic GBM expression data")
    ax.grid(alpha=0.2)
    if legend_handles:
        ax.legend(handles=legend_handles, title="Predicted subtype")
    fig.tight_layout()
    return save_figure(fig, output_dir, "fig4_gbm_expression_pca.png", dpi, overwrite)


