    ax.set_title("Alteration frequency by predicted expression subtype")
    fig.tight_layout()
    return save_figure(fig, output_dir, "fig8_gbm_genomic_frequency_by_expression_subtype.png", dpi, overwrite)


def fig9_gbm_burden_by_expression_subtype(
    merged_cohort: pd.DataFrame,
    output_dir: Path,
    dpi: int,
    overwrite: bool,
) -> Path:
    """Figure 9: mutation burden and FGA by predicted expression subtype."""
    fig, axes = plt.subplots(1, 2, figsize=(10, 4.5))
    for ax, variable in zip(axes, ["MUTATION_COUNT", "FGA"]):
        data = []
        for subtype in ["Proneural", "Classical", "Mesenchymal", "Mixed/Ambiguous"]:
            subset = merged_cohort[merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"] == subtype]
            if subset.empty:
                continue
            data.append((subtype, subset[variable].dropna().tolist()))
        if sns is not None:
            sns.boxplot(data=[values for _, values in data], ax=ax, palette=[DEFAULT_PALETTE[subtype] for subtype, _ in data])
            ax.set_xticklabels([subtype for subtype, _ in data], rotation=30)
        else:
            bp = ax.boxplot([values for _, values in data], patch_artist=True)
            for box, color in zip(bp["boxes"], [DEFAULT_PALETTE[subtype] for subtype, _ in data]):
                box.set_facecolor(color)
            ax.set_xticklabels([subtype for subtype, _ in data], rotation=30)
        ax.set_title(variable.replace("_", " ").title())
        ax.set_ylabel(variable)
    fig.suptitle("Genomic burden by predicted subtype")
    fig.tight_layout()
    return save_figure(fig, output_dir, "fig9_gbm_burden_by_expression_subtype.png", dpi, overwrite)


