def parse_args() -> argparse.Namespace:
    """Parse CLI arguments for the GBM deep-dive pipeline."""
    parser = argparse.ArgumentParser(description="Generate synthetic GBM RNA-expression deep-dive figures")
    parser.add_argument("--input-csv", type=str, default=None, help="Optional CSV file with the existing synthetic cohort")
    parser.add_argument("--output-dir", type=str, default="figures/gbm_deep_dive", help="Directory for outputs")
    parser.add_argument("--seed", type=int, default=42, help="Random seed for all synthetic steps")
    parser.add_argument("--minimum-margin", type=float, default=0.25, help="Minimum subtype-score margin for confident classification")
    parser.add_argument("--minimum-top-score", type=float, default=None, help="Optional minimum top-score threshold")
    parser.add_argument("--subtype-effect-size", type=float, default=1.5, help="Effect size for subtype-specific expression signatures")
    parser.add_argument("--noise-sd", type=float, default=1.0, help="Noise level for synthetic expression generation")
    parser.add_argument("--mixed-fraction", type=float, default=0.12, help="Approximate fraction of samples assigned a mixed latent subtype")
    parser.add_argument("--n-background-genes", type=int, default=40, help="Number of background genes to include")
    parser.add_argument("--genomic-enrichment-strength", type=float, default=0.35, help="Strength of soft genomic enrichment for latent subtype generation")
    parser.add_argument("--simulate-subtype-survival", action="store_true", help="Simulate subtype-associated survival outcomes in additional columns")
    parser.add_argument("--max-heatmap-samples", type=int, default=120, help="Maximum number of samples to display in heatmaps")
    parser.add_argument("--dpi", type=int, default=300, help="DPI for saved figures")
    parser.add_argument("--overwrite", action="store_true", help="Allow overwriting existing output files")
    return parser.parse_args()


def ensure_output_directory(output_dir: Path) -> None:
    """Create the output directory if needed."""
    output_dir.mkdir(parents=True, exist_ok=True)


def resolve_output_path(output_dir: Path, filename: str, overwrite: bool) -> Path:
    """Return a safe output path, raising if the file exists and overwrite is disabled."""
    path = output_dir / filename
    if path.exists() and not overwrite:
        raise FileExistsError(
            f"Refusing to overwrite existing file: {path}. Re-run with --overwrite to allow replacement."
        )
    return path


def save_dataframe_csv(df: pd.DataFrame, output_dir: Path, filename: str, overwrite: bool) -> Path:
    """Save a dataframe to CSV using overwrite safeguards."""
    path = resolve_output_path(output_dir, filename, overwrite)
    df.to_csv(path, index=False)
    logger.info("Saved %s", path)
    return path


def save_json(data: Dict[str, Any], output_dir: Path, filename: str, overwrite: bool) -> Path:
    """Save JSON output using overwrite safeguards."""
    path = resolve_output_path(output_dir, filename, overwrite)
    with path.open("w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
    logger.info("Saved %s", path)
    return path


def save_figure(fig, output_dir: Path, filename: str, dpi: int, overwrite: bool) -> Path:
    """Save a matplotlib figure and close it afterwards."""
    path = resolve_output_path(output_dir, filename, overwrite)
    fig.savefig(path, dpi=dpi, bbox_inches="tight")
    plt.close(fig)
    logger.info("Saved %s", path)
    return path


def load_cohort(input_csv: str | None) -> pd.DataFrame:
    """Load the cohort from the existing generator or an optional CSV file."""
    if input_csv:
        logger.info("Loading cohort from CSV: %s", input_csv)
        cohort = pd.read_csv(input_csv)
        if "molecular_subtype" not in cohort.columns:
            raise ValueError("The input CSV must contain a 'molecular_subtype' column.")
        return _prepare_cohort_dataframe(cohort)

    logger.info("Loading cohort via generate_representative_cohort()")
    script_dir = Path(__file__).resolve().parent
    if str(script_dir) not in sys.path:
        sys.path.insert(0, str(script_dir))

    try:
        from generate_figures import generate_representative_cohort
    except Exception as exc:  # pragma: no cover
        raise ImportError(
            "Could not import generate_figures.py. Ensure the file is present in the workspace and importable."
        ) from exc

    try:
        generator = generate_representative_cohort
        signature = inspect.signature(generator)
        if len(signature.parameters) == 0:
            cohort = generator()
        else:
            cohort = generator(**{})
    except TypeError as exc:
        raise TypeError(
            "The imported generator did not match the expected no-argument interface."
        ) from exc

    return _prepare_cohort_dataframe(cohort)


def _prepare_cohort_dataframe(cohort: pd.DataFrame) -> pd.DataFrame:
    """Prepare the input cohort for analysis by validating required columns and deriving OS fields."""
    if cohort.empty:
        raise ValueError("The input cohort is empty.")

    if "molecular_subtype" not in cohort.columns:
        raise ValueError("The input cohort is missing the 'molecular_subtype' column.")

    if "OS_TIME" not in cohort.columns and "OS_MONTHS" in cohort.columns:
        cohort = cohort.copy()
        cohort["OS_TIME"] = pd.to_numeric(cohort["OS_MONTHS"], errors="coerce")
    if "OS_EVENT" not in cohort.columns and "OS_STATUS" in cohort.columns:
        cohort = cohort.copy()
        cohort["OS_EVENT"] = cohort["OS_STATUS"].apply(lambda value: 1 if "DECEASED" in str(value) else 0)

    missing = [col for col in REQUIRED_COLUMNS if col not in cohort.columns]
    if missing:
        raise ValueError(f"The cohort is missing required columns: {', '.join(missing)}")

    cohort = cohort.copy()
    for col in ["OS_TIME", "OS_EVENT"]:
        if col in cohort.columns:
            cohort[col] = pd.to_numeric(cohort[col], errors="coerce")

    invalid_os_time = cohort["OS_TIME"].isna() | (cohort["OS_TIME"] <= 0)
    if invalid_os_time.any():
        raise ValueError(
            "Invalid survival values found in OS_TIME. All values must be positive, finite numbers."
        )

    event_values = set(cohort["OS_EVENT"].dropna().astype(int).unique())
    if not event_values.issubset({0, 1}):
        raise ValueError("OS_EVENT must contain only 0/1 values for event status.")

    for col in [
        "IDH1_mut",
        "IDH2_mut",
        "TP53_mut",
        "ATRX_mut",
        "TERT_mut",
        "EGFR_amp",
        "PTEN_del",
        "CDKN2A_del",
        "CDKN2B_del",
        "NF1_mut",
        "RB1_mut",
        "PIK3CA_mut",
        "PIK3R1_mut",
        "PDGFRA_amp",
        "ARID1A_mut",
        "SETD2_mut",
        "MET_amp",
        "FGFR3_mut",
        "ATM_mut",
    ]:
        if col in cohort.columns:
            cohort[col] = cohort[col].fillna(False).astype(bool)

    cohort["AGE"] = pd.to_numeric(cohort["AGE"], errors="coerce")
    cohort["FGA"] = pd.to_numeric(cohort["FGA"], errors="coerce")
    cohort["MUTATION_COUNT"] = pd.to_numeric(cohort["MUTATION_COUNT"], errors="coerce")
    cohort["OS_TIME"] = pd.to_numeric(cohort["OS_TIME"], errors="coerce")
    cohort["OS_EVENT"] = pd.to_numeric(cohort["OS_EVENT"], errors="coerce")

    return cohort


def filter_gbm_cohort(cohort: pd.DataFrame) -> pd.DataFrame:
    """Filter to the IDH-wildtype GBM cohort and create synthetic sample IDs."""
    gbm = cohort[cohort["molecular_subtype"] == "IDH-wildtype GBM"].copy()
    if gbm.empty:
        raise ValueError("No 'IDH-wildtype GBM' cases were found in the input cohort.")

    # In real studies, longitudinal workflows should use separate PATIENT_ID and SAMPLE_ID fields.
    gbm = gbm.reset_index(drop=True)
    gbm["SAMPLE_ID"] = [f"GBM_{index:04d}" for index in range(1, len(gbm) + 1)]
    return gbm


def assign_latent_expression_subtype(
    gbm_cohort: pd.DataFrame,
    genomic_enrichment_strength: float,
    mixed_fraction: float,
    random_seed: int,
) -> pd.DataFrame:
    """Assign a hidden latent expression subtype using soft genomic enrichment."""
    rng = np.random.default_rng(random_seed + 99)
    subtypes = ["Proneural", "Classical", "Mesenchymal", "Mixed"]
    latent_labels = []

    for _, row in gbm_cohort.iterrows():
        probs = np.array([0.24, 0.24, 0.24, 0.28], dtype=float) # Base probabilities for Proneural, Classical, Mesenchymal, Mixed

        # Soft, probabilistic enrichment from genomic flags.
        if bool(row.get("EGFR_amp", False)):
            probs[1] += genomic_enrichment_strength * 0.35
        if bool(row.get("NF1_mut", False)):
            probs[2] += genomic_enrichment_strength * 0.35
        if bool(row.get("PDGFRA_amp", False)):
            probs[0] += genomic_enrichment_strength * 0.35
        if bool(row.get("PTEN_del", False)):
            probs[1] += genomic_enrichment_strength * 0.10
        if str(row.get("SAMPLE_TYPE", "")).lower() == "recurrence":
            probs[2] += 0.06
        if float(row.get("FGA", 0.0)) > 0.65:
            probs[3] += 0.04
        if float(row.get("MUTATION_COUNT", 0)) > 8:
            probs[2] += 0.03

        # Allow a modest fraction of samples to be latent Mixed.
        if rng.random() < mixed_fraction:
            probs[3] += 0.35

        probs = np.clip(probs, 1e-6, None)
        probs = probs / probs.sum()
        latent_labels.append(rng.choice(subtypes, p=probs))

    gbm_cohort = gbm_cohort.copy()
    gbm_cohort["LATENT_EXPRESSION_SUBTYPE"] = latent_labels
    return gbm_cohort


def generate_synthetic_gbm_expression(
    gbm_cohort: pd.DataFrame,
    signatures: Dict[str, List[str]],
    random_seed: int,
    subtype_effect_size: float,
    noise_sd: float,
    mixed_fraction: float,
    n_background_genes: int,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """Generate synthetic log2-like bulk RNA-expression data for the GBM cohort."""
    rng = np.random.default_rng(random_seed)

    if not signatures:
        raise ValueError("At least one expression signature must be provided.")

    gene_names: List[str] = []
    signature_gene_to_program: Dict[str, str] = {}
    for program, genes in signatures.items():
        if len(genes) < 3:
            raise ValueError(f"Signature '{program}' has too few genes to be meaningful.")
        for gene in genes:
            if gene in signature_gene_to_program:
                raise ValueError(f"Gene '{gene}' appears in more than one signature; rename or document the overlap.")
            gene_names.append(gene)
            signature_gene_to_program[gene] = program

    background_genes = [f"BG_{i:02d}" for i in range(n_background_genes)]
    gene_names.extend(background_genes)
    for gene in background_genes:
        signature_gene_to_program[gene] = "Background"

    n_samples = len(gbm_cohort)
    n_genes = len(gene_names)

    gene_baseline = rng.normal(loc=5.5, scale=0.9, size=n_genes)
    gene_dispersion = np.clip(rng.normal(loc=1.0, scale=0.2, size=n_genes), 0.35, 1.8)
    sample_factor = rng.normal(loc=0.0, scale=0.35, size=n_samples)
    shared_noise = rng.normal(loc=0.0, scale=0.45, size=(n_samples, n_genes))

    expression = np.outer(np.ones(n_samples), gene_baseline)
    expression += np.outer(sample_factor, np.ones(n_genes)) * 0.25
    expression += shared_noise * gene_dispersion[None, :]

    # Add weak associations with burden and recurrence status for realism.
    fga = gbm_cohort["FGA"].to_numpy(dtype=float)
    mutation_count = gbm_cohort["MUTATION_COUNT"].to_numpy(dtype=float)
    expression += np.outer((fga - 0.5) * 0.08, np.ones(n_genes))
    expression += np.outer(np.clip(mutation_count / 30.0, 0.0, 1.3) * 0.02, np.ones(n_genes))

    # Add subtype-specific structure. This is synthetic and meant to be educational.
    for idx, row in gbm_cohort.iterrows():
        latent = row["LATENT_EXPRESSION_SUBTYPE"]
        if latent == "Mixed":
            programs = ["Proneural", "Classical"]
            if rng.random() < 0.5:
                programs = ["Proneural", "Mesenchymal"]
            elif rng.random() < 0.5:
                programs = ["Classical", "Mesenchymal"]
            effect_scale = subtype_effect_size * 0.75
        else:
            programs = [latent]
            effect_scale = subtype_effect_size

        for program in programs:
            genes = signatures.get(program, [])
            for gene in genes:
                if gene not in signature_gene_to_program:
                    continue
                gene_index = gene_names.index(gene)
                expression[idx, gene_index] += effect_scale * (1.0 + 0.1 * rng.normal())

    expression = np.maximum(expression, 0.5)

    expression_df = pd.DataFrame(expression, index=gbm_cohort["SAMPLE_ID"].tolist(), columns=gene_names)
    expression_df.index.name = "SAMPLE_ID"

    metadata = gbm_cohort[["SAMPLE_ID", "LATENT_EXPRESSION_SUBTYPE"]].copy()
    metadata["SIMULATED_EXPRESSION_NOTE"] = "Synthetic log2-normalized bulk RNA-expression values"
    metadata["SIMULATION_SUBTYPE_EFFECT_SIZE"] = subtype_effect_size
    metadata["SIMULATION_NOISE_SD"] = noise_sd
    metadata["SIMULATION_MIXED_FRACTION"] = mixed_fraction
    metadata["SIMULATION_BACKGROUND_GENES"] = n_background_genes
    return expression_df, metadata


def validate_expression_matrix(expression_matrix: pd.DataFrame, sample_ids: Sequence[str]) -> None:
    """Validate the expression matrix and raise actionable errors if needed."""
    if expression_matrix.empty:
        raise ValueError("The synthetic expression matrix is empty.")

    if len(sample_ids) != len(expression_matrix.index):
        raise ValueError("Expression matrix row count does not match the number of GBM samples.")

    if expression_matrix.index.duplicated().any():
        raise ValueError("Expression matrix contains duplicate sample IDs.")

    if expression_matrix.columns.duplicated().any():
        raise ValueError("Expression matrix contains duplicate gene columns.")

    if expression_matrix.shape[1] == 0:
        raise ValueError("The expression matrix contains no genes.")

    if expression_matrix.isna().all(axis=0).any():
        raise ValueError("The expression matrix contains genes with all missing values.")

    if not np.isfinite(expression_matrix.to_numpy(dtype=float)).all():
        raise ValueError("The expression matrix contains non-finite values.")

    if expression_matrix.shape[0] != len(set(sample_ids)):
        raise ValueError("Sample ID values are not unique.")

    zero_variance = []
    for column in expression_matrix.columns:
        values = pd.to_numeric(expression_matrix[column], errors="coerce")
        if values.isna().all():
            continue
        std = np.nanstd(values.to_numpy(dtype=float))
        if not np.isfinite(std) or std <= 1e-12:
            zero_variance.append(column)
    if zero_variance:
        logger.warning("Zero-variance genes detected and will be handled safely: %s", ", ".join(zero_variance[:10]))


def zscore_expression_by_gene(expression_matrix: pd.DataFrame) -> pd.DataFrame:
    """Z-score each gene across the GBM samples.

    The z-score answers: is this gene unusually active in this sample compared with
    the other GBM samples? The output uses standardized expression values to make
    downstream scoring and visualization more comparable.
    """
    standardized = expression_matrix.copy()
    for column in standardized.columns:
        values = pd.to_numeric(standardized[column], errors="coerce")
        if values.isna().all():
            standardized[column] = 0.0
            continue
        mean = float(np.nanmean(values.to_numpy(dtype=float)))
        std = float(np.nanstd(values.to_numpy(dtype=float)))
        if not np.isfinite(std) or std <= 1e-12:
            standardized[column] = 0.0
            continue
        standardized[column] = ((values - mean) / std).astype(float)
    return standardized


def calculate_expression_subtype_scores(
    standardized_expression: pd.DataFrame,
    signatures: Dict[str, List[str]],
) -> pd.DataFrame:
    """Calculate mean standardized expression scores for each signature."""
    rows = []
    for sample_id in standardized_expression.index:
        row_scores = {"SAMPLE_ID": sample_id}
        for program, genes in signatures.items():
            available_genes = [gene for gene in genes if gene in standardized_expression.columns]
            if len(available_genes) < 3:
                raise ValueError(
                    f"Signature '{program}' has too few genes available in the expression matrix ({len(available_genes)})."
                )
            values = standardized_expression.loc[sample_id, available_genes].astype(float)
            row_scores[f"{program.upper()}_SCORE"] = float(values.mean())
            row_scores[f"{program.upper()}_GENES_USED"] = len(available_genes)
        rows.append(row_scores)

    scores_df = pd.DataFrame(rows)
    score_columns = [
        "PRONEURAL_SCORE",
        "CLASSICAL_SCORE",
        "MESENCHYMAL_SCORE",
        "PRONEURAL_GENES_USED",
        "CLASSICAL_GENES_USED",
        "MESENCHYMAL_GENES_USED",
    ]
    for column in score_columns:
        if column not in scores_df.columns:
            raise ValueError(f"Subtype scoring output is missing required column: {column}")
    return scores_df


def assign_expression_subtype(
    subtype_scores: pd.DataFrame,
    minimum_margin: float,
    minimum_top_score: float | None = None,
) -> pd.DataFrame:
    """Classify each sample into a transcriptional subtype or Mixed/Ambiguous."""
    labelled = subtype_scores.copy()
    score_columns = ["PRONEURAL_SCORE", "CLASSICAL_SCORE", "MESENCHYMAL_SCORE"]
    classification = []

    for _, row in labelled.iterrows():
        values = np.array([row[column] for column in score_columns], dtype=float)
        order = np.argsort(values)
        top_index = order[-1]
        second_index = order[-2]
        top_score = float(values[top_index])
        second_score = float(values[second_index])
        margin = top_score - second_score

        if minimum_top_score is not None and top_score < minimum_top_score:
            label = "Mixed/Ambiguous"
            confidence = "Ambiguous"
        elif margin < minimum_margin:
            label = "Mixed/Ambiguous"
            confidence = "Ambiguous"
        else:
            label = score_columns[top_index].replace("_SCORE", "").replace("PRONEURAL", "Proneural").replace("CLASSICAL", "Classical").replace("MESENCHYMAL", "Mesenchymal")
            if top_score >= 0.75 and margin >= 0.60:
                confidence = "High"
            elif top_score >= 0.45 and margin >= 0.35:
                confidence = "Moderate"
            else:
                confidence = "Low"

        classification.append((label, top_score, second_score, margin, confidence))

    labelled["PREDICTED_EXPRESSION_SUBTYPE"] = [item[0] for item in classification]
    labelled["TOP_SCORE"] = [item[1] for item in classification]
    labelled["SECOND_SCORE"] = [item[2] for item in classification]
    labelled["SUBTYPE_MARGIN"] = [item[3] for item in classification]
    labelled["CLASSIFICATION_CONFIDENCE"] = [item[4] for item in classification]
    return labelled


def validate_survival_columns(gbm_cohort: pd.DataFrame) -> None:
    """Validate survival fields before statistical analyses."""
    if "OS_TIME" not in gbm_cohort.columns or "OS_EVENT" not in gbm_cohort.columns:
        raise ValueError("The cohort must contain OS_TIME and OS_EVENT columns.")

    if gbm_cohort["OS_TIME"].isna().any():
        raise ValueError("OS_TIME contains missing values.")
    if gbm_cohort["OS_EVENT"].isna().any():
        raise ValueError("OS_EVENT contains missing values.")

    if (gbm_cohort["OS_TIME"] <= 0).any():
        raise ValueError("OS_TIME must be strictly positive for all samples.")

    events = set(pd.to_numeric(gbm_cohort["OS_EVENT"], errors="coerce").dropna().astype(int).unique())
    if not events.issubset({0, 1}):
        raise ValueError("OS_EVENT must contain only 0 and 1 values.")


def simulate_subtype_survival(gbm_cohort: pd.DataFrame, rng: np.random.Generator) -> pd.DataFrame:
    """Create synthetic subtype-associated survival outcomes without overwriting the original fields."""
    simulated = gbm_cohort.copy()
    base_time = np.exp(rng.normal(loc=2.7, scale=0.35, size=len(simulated)))
    base_time *= 12.0
    subtype_effect = np.zeros(len(simulated), dtype=float)

    for subtype in ["Proneural", "Classical", "Mesenchymal", "Mixed/Ambiguous"]:
        mask = simulated["PREDICTED_EXPRESSION_SUBTYPE"] == subtype
        if subtype == "Proneural":
            subtype_effect[mask] = -0.08
        elif subtype == "Classical":
            subtype_effect[mask] = -0.05
        elif subtype == "Mesenchymal":
            subtype_effect[mask] = 0.02
        else:
            subtype_effect[mask] = 0.04

    simulated_time = np.maximum(base_time * np.exp(subtype_effect), 1.0)
    event_prob = np.clip(0.75 - 0.006 * simulated_time + 0.03 * (simulated["MUTATION_COUNT"].astype(float) / 20.0), 0.10, 0.95)
    event_draw = rng.random(size=len(simulated)) < event_prob
    simulated["SIMULATED_GBM_OS_TIME"] = np.round(simulated_time, 2)
    simulated["SIMULATED_GBM_OS_EVENT"] = event_draw.astype(int)
    return simulated


def run_survival_analysis(
    merged_cohort: pd.DataFrame,
    use_simulated_survival: bool,
    output_dir: Path,
    overwrite: bool,
    dpi: int,
) -> Tuple[pd.DataFrame, Path]:
    """Run a Kaplan-Meier analysis and save a summary table and figure."""
    analysis_df = merged_cohort.copy()
    time_col = "SIMULATED_GBM_OS_TIME" if use_simulated_survival else "OS_TIME"
    event_col = "SIMULATED_GBM_OS_EVENT" if use_simulated_survival else "OS_EVENT"

    if use_simulated_survival:
        logger.info("Using simulated survival outcomes for the KM analysis.")
    else:
        logger.info("Using original OS_TIME and OS_EVENT for the KM analysis.")

    analysis_df = analysis_df.dropna(subset=[time_col, event_col]).copy()
    analysis_df = analysis_df[analysis_df[time_col] > 0].copy()

    summary_rows = []
    kmf = KaplanMeierFitter()
    fig, ax = plt.subplots(figsize=(9.5, 6.5))

    for subtype in TARGET_SUBTYPES:
        subset = analysis_df[analysis_df["PREDICTED_EXPRESSION_SUBTYPE"] == subtype]
        if len(subset) < 5:
            logger.warning("Group '%s' has too few samples for stable KM interpretation (%d).", subtype, len(subset))
            continue
        kmf.fit(subset[time_col], subset[event_col], label=f"{subtype} (n={len(subset)})")
        kmf.plot_survival_function(ax=ax, linewidth=2.2, ci_show=True, ci_alpha=0.12)
        median_survival = np.nan if pd.isna(kmf.median_survival_time_) else kmf.median_survival_time_
        summary_rows.append(
            {
                "SUBTYPE": subtype,
                "N": int(len(subset)),
                "N_EVENTS": int(subset[event_col].sum()),
                "MEDIAN_SURVIVAL": median_survival,
                "TIME_COLUMN": time_col,
                "EVENT_COLUMN": event_col,
            }
        )

    if not summary_rows:
        raise ValueError("No valid survival groups were available for analysis.")

    if len(analysis_df["PREDICTED_EXPRESSION_SUBTYPE"].unique()) > 1:
        try:
            result = logrank_test(
                analysis_df.loc[analysis_df["PREDICTED_EXPRESSION_SUBTYPE"] == "Proneural", time_col],
                analysis_df.loc[analysis_df["PREDICTED_EXPRESSION_SUBTYPE"] == "Classical", time_col],
                event_observed_A=analysis_df.loc[analysis_df["PREDICTED_EXPRESSION_SUBTYPE"] == "Proneural", event_col],
                event_observed_B=analysis_df.loc[analysis_df["PREDICTED_EXPRESSION_SUBTYPE"] == "Classical", event_col],
            )
            p_value = result.p_value
        except Exception:
            p_value = np.nan
    else:
        p_value = np.nan

    ax.set_xlabel("Time (months)", fontsize=12)
    ax.set_ylabel("Overall Survival Probability", fontsize=12)
    title = "Kaplan-Meier survival by predicted GBM expression subtype"
    if use_simulated_survival:
        title += " (simulated subtype-associated outcomes)"
    ax.set_title(title, fontsize=13, fontweight="bold")
    ax.grid(alpha=0.2)
    if sns is not None:
        sns.despine(ax=ax)
    else:
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)
    ax.text(0.98, 0.02, f"Log-rank p = {p_value:.3g}", transform=ax.transAxes, ha="right", va="bottom")
    ax.legend(loc="upper right")
    fig.tight_layout()
    path = save_figure(fig, output_dir, "fig7_gbm_km_by_expression_subtype.png", dpi, overwrite)

    summary_df = pd.DataFrame(summary_rows)
    summary_df["LOG_RANK_P_VALUE"] = p_value
    summary_path = save_dataframe_csv(summary_df, output_dir, "gbm_survival_summary.csv", overwrite)
    return summary_df, summary_path


def run_genomic_enrichment_analysis(
    merged_cohort: pd.DataFrame,
    output_dir: Path,
    overwrite: bool,
) -> pd.DataFrame:
    """Calculate enrichment of genomic alterations by predicted expression subtype."""
    subtype_labels = ["Proneural", "Classical", "Mesenchymal", "Mixed/Ambiguous"]
    feature_list = [
        "EGFR_any",
        "NF1_any",
        "PDGFRA_any",
        "PTEN_any",
        "CDKN2A_any",
        "CDKN2B_any",
        "TP53_any",
        "RB1_any",
        "PIK3CA_any",
        "PIK3R1_any",
        "MET_any",
    ]

    results = []
    for feature in feature_list:
        if feature not in merged_cohort.columns:
            continue
        for subtype in subtype_labels:
            subgroup = merged_cohort[merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"] == subtype]
            if subgroup.empty:
                continue
            altered = subgroup[feature].fillna(False).astype(bool).sum()
            total = len(subgroup)
            pct = altered / total if total else np.nan
            comparison = merged_cohort[merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"] != subtype]
            alt_other = comparison[feature].fillna(False).astype(bool).sum()
            total_other = len(comparison)
            if total <= 0 or total_other <= 0:
                p_value = np.nan
                odds_ratio = np.nan
            else:
                table = np.array([[altered, total - altered], [alt_other, total_other - alt_other]], dtype=int)
                try:
                    if np.any(table < 5):
                        _, p_value = fisher_exact(table, alternative="two-sided")
                    else:
                        chi2, p_value, _, _ = chi2_contingency(table)
                    odds_ratio = (altered / max(total - altered, 1)) / (alt_other / max(total_other - alt_other, 1))
                except Exception:
                    p_value = np.nan
                    odds_ratio = np.nan

            results.append(
                {
                    "FEATURE": feature,
                    "SUBTYPE": subtype,
                    "N_ALTERED": int(altered),
                    "N_TOTAL": int(total),
                    "PERCENT_ALTERED": pct,
                    "ODDS_RATIO": odds_ratio,
                    "P_VALUE": p_value,
                }
            )

    enrichment_df = pd.DataFrame(results)
    if enrichment_df.empty:
        raise ValueError("No genomic enrichment results were generated.")
    enrichment_df = enrichment_df.sort_values(["FEATURE", "SUBTYPE"]).reset_index(drop=True)
    enrichment_df["FDR_Q_VALUE"] = multipletests(enrichment_df["P_VALUE"].fillna(1.0), method="fdr_bh")[1]
    enrichment_df["SIGNIFICANT_FDR_0_05"] = enrichment_df["FDR_Q_VALUE"] < 0.05
    save_dataframe_csv(enrichment_df, output_dir, "gbm_genomic_enrichment_results.csv", overwrite)
    return enrichment_df


def evaluate_classification(
    merged_cohort: pd.DataFrame,
    output_dir: Path,
    overwrite: bool,
) -> pd.DataFrame:
    """Evaluate the synthetic classifier against the hidden latent subtype labels."""
    latent_col = "LATENT_EXPRESSION_SUBTYPE"
    pred_col = "PREDICTED_EXPRESSION_SUBTYPE"
    if latent_col not in merged_cohort.columns or pred_col not in merged_cohort.columns:
        raise ValueError("Classification evaluation requires latent and predicted subtype columns.")

    strict_classes = ["Proneural", "Classical", "Mesenchymal", "Mixed", "Mixed/Ambiguous"]
    strict_true = []
    strict_pred = []

    for _, row in merged_cohort.iterrows():
        latent = str(row[latent_col])
        pred = str(row[pred_col])
        strict_true.append(latent)
        strict_pred.append(pred)

    strict_metrics = {
        "overall_accuracy": _overall_accuracy(strict_true, strict_pred, strict_classes),
        "balanced_accuracy": _balanced_accuracy(strict_true, strict_pred, strict_classes),
        "confusion_matrix": _build_confusion_matrix(strict_true, strict_pred, strict_classes),
        "strict_classes": strict_classes,
        "strict_percentage_mixed_ambiguous": (np.array(strict_pred) == "Mixed/Ambiguous").mean(),
    }

    single_class_mask = np.array([label in {"Proneural", "Classical", "Mesenchymal"} for label in strict_true]) & np.array([pred in {"Proneural", "Classical", "Mesenchymal"} for pred in strict_pred])
    single_true = np.array(strict_true)[single_class_mask]
    single_pred = np.array(strict_pred)[single_class_mask]
    single_classes = ["Proneural", "Classical", "Mesenchymal"]
    single_metrics = {
        "overall_accuracy": _overall_accuracy(single_true, single_pred, single_classes),
        "balanced_accuracy": _balanced_accuracy(single_true, single_pred, single_classes),
        "confusion_matrix": _build_confusion_matrix(single_true, single_pred, single_classes),
        "single_class_only": True,
    }

    metrics_rows = []
    for name, metrics in {"strict": strict_metrics, "single_class_only": single_metrics}.items():
        for class_name in strict_classes if name == "strict" else ["Proneural", "Classical", "Mesenchymal"]:
            precision = _precision_for_class(metrics["confusion_matrix"], class_name, classes=strict_classes if name == "strict" else ["Proneural", "Classical", "Mesenchymal"])
            recall = _recall_for_class(metrics["confusion_matrix"], class_name, classes=strict_classes if name == "strict" else ["Proneural", "Classical", "Mesenchymal"])
            f1 = _f1_score(precision, recall)
            metrics_rows.append(
                {
                    "EVALUATION": name,
                    "CLASS": class_name,
                    "PRECISION": precision,
                    "RECALL": recall,
                    "F1_SCORE": f1,
                }
            )
        metrics_rows.append(
            {
                "EVALUATION": name,
                "CLASS": "OVERALL",
                "PRECISION": np.nan,
                "RECALL": np.nan,
                "F1_SCORE": np.nan,
                "OVERALL_ACCURACY": metrics["overall_accuracy"],
                "BALANCED_ACCURACY": metrics["balanced_accuracy"],
                "PERCENT_MIXED_AMBIGUOUS": metrics.get("strict_percentage_mixed_ambiguous", np.nan),
            }
        )

    metrics_df = pd.DataFrame(metrics_rows)
    save_dataframe_csv(metrics_df, output_dir, "gbm_classification_metrics.csv", overwrite)
    return metrics_df


def _overall_accuracy(true_labels: Sequence[str], pred_labels: Sequence[str], classes: Sequence[str]) -> float:
    if len(true_labels) != len(pred_labels):
        raise ValueError("True and predicted label lengths differ.")
    correct = sum(1 for true, pred in zip(true_labels, pred_labels) if true == pred)
    return correct / len(true_labels) if len(true_labels) else np.nan


def _balanced_accuracy(true_labels: Sequence[str], pred_labels: Sequence[str], classes: Sequence[str]) -> float:
    if len(true_labels) != len(pred_labels):
        raise ValueError("True and predicted label lengths differ.")
    recalls = []
    for class_name in classes:
        tp = sum(1 for true, pred in zip(true_labels, pred_labels) if true == class_name and pred == class_name)
        actual = sum(1 for true in true_labels if true == class_name)
        recall = tp / actual if actual else np.nan
        recalls.append(recall)
    recalls = [value for value in recalls if np.isfinite(value)]
    return float(np.mean(recalls)) if recalls else np.nan


def _build_confusion_matrix(true_labels: Sequence[str], pred_labels: Sequence[str], classes: Sequence[str]) -> Dict[str, Dict[str, int]]:
    matrix = {label: {pred: 0 for pred in classes} for label in classes}
    for true, pred in zip(true_labels, pred_labels):
        if true in matrix and pred in matrix[true]:
            matrix[true][pred] += 1
    return matrix


def _precision_for_class(confusion_matrix: Dict[str, Dict[str, int]], class_name: str, classes: Sequence[str]) -> float:
    tp = confusion_matrix.get(class_name, {}).get(class_name, 0)
    predicted_positive = sum(confusion_matrix[other].get(class_name, 0) for other in classes)
    return tp / predicted_positive if predicted_positive else np.nan


def _recall_for_class(confusion_matrix: Dict[str, Dict[str, int]], class_name: str, classes: Sequence[str]) -> float:
    tp = confusion_matrix.get(class_name, {}).get(class_name, 0)
    actual_positive = sum(confusion_matrix[class_name].values())
    return tp / actual_positive if actual_positive else np.nan


def _f1_score(precision: float, recall: float) -> float:
    if np.isnan(precision) or np.isnan(recall) or (precision + recall) == 0:
        return np.nan
    return 2 * precision * recall / (precision + recall)


def make_summary_counts(merged_cohort: pd.DataFrame) -> pd.DataFrame:
    """Create a simple summary count table by predicted subtype and confidence."""
    counts = merged_cohort.groupby("PREDICTED_EXPRESSION_SUBTYPE").size().rename("N")
    percentages = (counts / len(merged_cohort) * 100).round(1).rename("PERCENT")
    confidence = merged_cohort.groupby(["PREDICTED_EXPRESSION_SUBTYPE", "CLASSIFICATION_CONFIDENCE"]).size().unstack(fill_value=0)
    summary = pd.concat([counts, percentages], axis=1)
    summary = summary.reset_index()
    summary = summary.rename(columns={"index": "PREDICTED_EXPRESSION_SUBTYPE"})
    if "CLASSIFICATION_CONFIDENCE" in confidence.columns:
        confidence = confidence.reset_index()
        summary = summary.merge(confidence, on="PREDICTED_EXPRESSION_SUBTYPE", how="left")
    return summary


