def main() -> None: # Runs the pipeline for the GBM deep-dive analysis, including synthetic data generation, subtype classification, survival analysis, genomic enrichment, and figure generation.    
    """Run the full GBM deep-dive workflow."""
    args = parse_args()
    output_dir = Path(args.output_dir).resolve()
    ensure_output_directory(output_dir)

    logger.info("Starting GBM deep-dive analysis")
    logger.info("Output directory: %s", output_dir)

    cohort = load_cohort(args.input_csv) # 1. Obtain the existing synthetic cohort from generate_figures.py
    gbm_cohort = filter_gbm_cohort(cohort) # 2. Select only IDH-wildtype GBM cases: 1100 records
    gbm_cohort = assign_latent_expression_subtype(
        gbm_cohort,
        genomic_enrichment_strength=args.genomic_enrichment_strength,
        mixed_fraction=args.mixed_fraction,
        random_seed=args.seed,
    ) # Generate synthetic RNA-expression data for the GBM cohort based on the latent subtype labels and specified parameters

    expression_matrix, expression_metadata = generate_synthetic_gbm_expression(
        gbm_cohort,
        GBM_EXPRESSION_SIGNATURES,
        random_seed=args.seed,
        subtype_effect_size=args.subtype_effect_size,
        noise_sd=args.noise_sd,
        mixed_fraction=args.mixed_fraction,
        n_background_genes=args.n_background_genes,
    ) # 3. Generate synthetic bulk RNA-expression data for those GBM samples

    validate_expression_matrix(expression_matrix, gbm_cohort["SAMPLE_ID"].tolist())
    standardized_expression = zscore_expression_by_gene(expression_matrix) # Standardize the expression values by gene (z-score normalization)

    raw_expression_path = save_dataframe_csv(expression_matrix.reset_index(), output_dir, "gbm_synthetic_expression_raw.csv", args.overwrite)
    zscore_expression_path = save_dataframe_csv(standardized_expression.reset_index(), output_dir, "gbm_synthetic_expression_zscore.csv", args.overwrite)

    subtype_scores = calculate_expression_subtype_scores(standardized_expression, GBM_EXPRESSION_SIGNATURES)
    subtype_scores = subtype_scores.merge(gbm_cohort[["SAMPLE_ID"]], on="SAMPLE_ID", how="left")
    subtype_scores = subtype_scores.sort_values("SAMPLE_ID").reset_index(drop=True)
    subtype_scores_path = save_dataframe_csv(subtype_scores, output_dir, "gbm_expression_subtype_scores.csv", args.overwrite)

    classification_df = assign_expression_subtype(
        subtype_scores,
        minimum_margin=args.minimum_margin,
        minimum_top_score=args.minimum_top_score,
    )

    merged_cohort = gbm_cohort.merge(classification_df, on="SAMPLE_ID", how="left", validate="one_to_one")
    merged_cohort = merged_cohort.merge(
        expression_metadata.drop(columns=["LATENT_EXPRESSION_SUBTYPE"]),
        on="SAMPLE_ID",
        how="left",
        validate="one_to_one",
    )

    # Validate required invariants before plotting.
    if merged_cohort.empty:
        raise ValueError("The merged GBM cohort is empty.")
    if merged_cohort["SAMPLE_ID"].duplicated().any():
        raise ValueError("Duplicate SAMPLE_ID values were introduced into the merged table.")
    if not np.isfinite(merged_cohort[["PRONEURAL_SCORE", "CLASSICAL_SCORE", "MESENCHYMAL_SCORE"]].to_numpy(dtype=float)).all():
        raise ValueError("Subtype scores contain non-finite values.")
    if not set(merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"].dropna().unique()).issubset(set(TARGET_SUBTYPES) | {"Mixed/Ambiguous"}):
        raise ValueError("Predicted expression subtype labels contain unexpected values.")

    validate_survival_columns(merged_cohort)

    if args.simulate_subtype_survival:
        rng = np.random.default_rng(args.seed + 123)
        merged_cohort = simulate_subtype_survival(merged_cohort, rng)

    save_dataframe_csv(merged_cohort, output_dir, "gbm_deep_dive_cohort.csv", args.overwrite)
    save_dataframe_csv(gbm_cohort[["SAMPLE_ID", "LATENT_EXPRESSION_SUBTYPE"]], output_dir, "gbm_filtered_cohort.csv", args.overwrite)

    enrichment_results = run_genomic_enrichment_analysis(merged_cohort, output_dir, args.overwrite)
    _ = evaluate_classification(merged_cohort, output_dir, args.overwrite)

    # Generate the requested figure set.
    fig1_gbm_expression_subtype_summary(merged_cohort, output_dir, args.dpi, args.overwrite)
    fig2_gbm_expression_signature_heatmap(
        merged_cohort,
        standardized_expression,
        GBM_EXPRESSION_SIGNATURES,
        output_dir,
        args.dpi,
        args.overwrite,
        args.max_heatmap_samples,
    )
    fig3_gbm_subtype_score_heatmap(subtype_scores, output_dir, args.dpi, args.overwrite)
    fig4_gbm_expression_pca(standardized_expression, merged_cohort, output_dir, args.dpi, args.overwrite)
    fig5_gbm_classification_confidence(merged_cohort, output_dir, args.dpi, args.overwrite, args.minimum_margin)
    fig6_gbm_expression_confusion_matrix(merged_cohort, output_dir, args.dpi, args.overwrite)
    run_survival_analysis(merged_cohort, args.simulate_subtype_survival, output_dir, args.overwrite, args.dpi)
    fig8_gbm_genomic_frequency_by_expression_subtype(merged_cohort, output_dir, args.dpi, args.overwrite)
    fig9_gbm_burden_by_expression_subtype(merged_cohort, output_dir, args.dpi, args.overwrite)
    fig10_gbm_deep_dive_overview(merged_cohort, output_dir, args.dpi, args.overwrite)

    summary_counts = make_summary_counts(merged_cohort)
    save_dataframe_csv(summary_counts, output_dir, "gbm_expression_subtype_summary.csv", args.overwrite)

    metadata = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "program_version": PROGRAM_VERSION,
        "random_seed": args.seed,
        "original_cohort_rows": int(len(cohort)),
        "gbm_rows": int(len(gbm_cohort)),
        "expression_genes": int(standardized_expression.shape[1]),
        "signature_genes": {key: len(value) for key, value in GBM_EXPRESSION_SIGNATURES.items()},
        "simulation_parameters": {
            "subtype_effect_size": args.subtype_effect_size,
            "noise_sd": args.noise_sd,
            "mixed_fraction": args.mixed_fraction,
            "n_background_genes": args.n_background_genes,
            "genomic_enrichment_strength": args.genomic_enrichment_strength,
            "minimum_margin": args.minimum_margin,
            "minimum_top_score": args.minimum_top_score,
        },
        "ambiguity_threshold": args.minimum_margin,
        "subtype_counts": merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"].value_counts().to_dict(),
        "output_paths": {
            "output_directory": str(output_dir),
            "raw_expression": str(raw_expression_path),
            "zscore_expression": str(zscore_expression_path),
            "subtype_scores": str(subtype_scores_path),
            "merged_cohort": str(output_dir / "gbm_deep_dive_cohort.csv"),
            "enrichment_results": str(output_dir / "gbm_genomic_enrichment_results.csv"),
            "survival_summary": str(output_dir / "gbm_survival_summary.csv"),
            "classification_metrics": str(output_dir / "gbm_classification_metrics.csv"),
        },
        "simulate_subtype_survival": bool(args.simulate_subtype_survival),
        "synthetic_note": "This pipeline uses synthetic data and should not be interpreted as a clinical diagnostic classifier.",
    }
    save_json(metadata, output_dir, "gbm_run_metadata.json", args.overwrite)

    logger.info("Original cohort rows: %d", len(cohort))
    logger.info("IDH-wildtype GBM rows: %d", len(gbm_cohort))
    logger.info("Expression genes generated: %d", standardized_expression.shape[1])
    logger.info("Predicted Proneural: %d", int((merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"] == "Proneural").sum()))
    logger.info("Predicted Classical: %d", int((merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"] == "Classical").sum()))
    logger.info("Predicted Mesenchymal: %d", int((merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"] == "Mesenchymal").sum()))
    logger.info("Predicted Mixed/Ambiguous: %d", int((merged_cohort["PREDICTED_EXPRESSION_SUBTYPE"] == "Mixed/Ambiguous").sum()))
    logger.info("Figures generated: 10")
    logger.info("Output directory: %s", output_dir)


if __name__ == "__main__":
    main()
