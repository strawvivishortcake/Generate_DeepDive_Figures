ADJUSTMENT_SETS = {'Base (TMB+FGA+age+sex)': [], '+ assay panel': ['PANEL_468_bin'], '+ ancestry': ['NON_EUROPEAN_ANCESTRY_bin'], '+ specimen origin': ['MET_ORIGIN_bin'], '+ panel + ancestry': ['PANEL_468_bin', 'NON_EUROPEAN_ANCESTRY_bin'], 'Fully adjusted': ['PANEL_468_bin', 'NON_EUROPEAN_ANCESTRY_bin', 'MET_ORIGIN_bin']}

def sensitivity_or_for_site(cohort: pd.DataFrame, site: str, extra_covariates: List[str]) -> Dict:
    covariates = ['FGA', 'TMB', 'AGE', 'SEX_bin'] + extra_covariates
    model_df = cohort.dropna(subset=['HLA_LOH_bin'] + covariates).copy()
    model_df[f'has_{site}'] = model_df['RECORDED_METASTATIC_SITES'].apply(lambda lst: site in lst)
    n_pos = int(model_df[f'has_{site}'].sum())
    if n_pos < 5:
        return {'OR': np.nan, 'OR_lo': np.nan, 'OR_hi': np.nan, 'P': np.nan, 'n': len(model_df), 'n_pos': n_pos, 'modeled': False}
    formula = f'has_{site} ~ HLA_LOH_bin + ' + ' + '.join(covariates)
    try:
        logit = smf.glm(formula, data=model_df, family=sm.families.Binomial()).fit(cov_type='HC3')
        beta, se, p = (logit.params['HLA_LOH_bin'], logit.bse['HLA_LOH_bin'], logit.pvalues['HLA_LOH_bin'])
        return {'OR': float(np.exp(beta)), 'OR_lo': float(np.exp(beta - 1.96 * se)), 'OR_hi': float(np.exp(beta + 1.96 * se)), 'P': float(p), 'n': len(model_df), 'n_pos': n_pos, 'modeled': True}
    except Exception as exc:
        logger.warning('Sensitivity model failed for site=%s, covariates=%s: %s', site, extra_covariates, exc)
        return {'OR': np.nan, 'OR_lo': np.nan, 'OR_hi': np.nan, 'P': np.nan, 'n': len(model_df), 'n_pos': n_pos, 'modeled': False}

def supp_fig3_and_table3_sensitivity(cohort: pd.DataFrame, sites: List[str], output_dir: Path, dpi: int, overwrite: bool) -> Tuple[Optional[Path], pd.DataFrame]:
    rows = []
    for site in sites:
        for adj_name, extra_covars in ADJUSTMENT_SETS.items():
            rows.append({'Site': site, 'Adjustment': adj_name, **sensitivity_or_for_site(cohort, site, extra_covars)})
    sens_table = pd.DataFrame(rows)
    modeled_mask = sens_table['modeled']
    sens_table['FDR_Q'] = np.nan
    if modeled_mask.any():
        sens_table.loc[modeled_mask, 'FDR_Q'] = multipletests(sens_table.loc[modeled_mask, 'P'], method='fdr_bh')[1]
    note_rows = []
    for site in sites:
        excl_target = cohort[~cohort['RECORDED_METASTATIC_SITES'].apply(lambda lst: site in lst) | (cohort['SAMPLE_TYPE'] != 'Metastasis')]
        n_pos_excl = int(excl_target['RECORDED_METASTATIC_SITES'].apply(lambda lst: site in lst).sum())
        primary_only = cohort[cohort['SAMPLE_TYPE'] == 'Primary']
        n_pos_primary = int(primary_only['RECORDED_METASTATIC_SITES'].apply(lambda lst: site in lst).sum())
        for label, subset_n, n_pos in [('Target-site-biopsy-excluded (NOT MODELED)', len(excl_target), n_pos_excl), ('Primary-biopsy-only (NOT MODELED)', len(primary_only), n_pos_primary)]:
            note_rows.append({'Site': site, 'Adjustment': label, 'n': subset_n, 'n_pos': n_pos, 'modeled': False, 'OR': np.nan, 'OR_lo': np.nan, 'OR_hi': np.nan, 'P': np.nan, 'FDR_Q': np.nan})
    sens_table = pd.concat([sens_table, pd.DataFrame(note_rows)], ignore_index=True)
    if not sites:
        return (None, sens_table)
    pivot = sens_table[sens_table['modeled']].pivot(index='Site', columns='Adjustment', values='OR').reindex(columns=list(ADJUSTMENT_SETS.keys()))
    log2_or = np.log2(pivot.astype(float))
    clip_bound = float(np.ceil(log2_or.abs().to_numpy().max() * 10) / 10) if log2_or.size else 1.0
    log2_or_clipped = log2_or.clip(-clip_bound, clip_bound)
    fig, ax = plt.subplots(figsize=(9, 2.0 + 0.6 * len(pivot)))
    im = ax.imshow(log2_or_clipped.values, cmap=DIVERGING_CMAP, vmin=-clip_bound, vmax=clip_bound, aspect='auto')
    ax.set_xticks(range(len(pivot.columns)))
    ax.set_xticklabels(pivot.columns, rotation=30, ha='right', fontsize=9)
    ax.set_yticks(range(len(pivot.index)))
    ax.set_yticklabels(pivot.index)
    ax.set_xticks(np.arange(-0.5, len(pivot.columns), 1), minor=True)
    ax.set_yticks(np.arange(-0.5, len(pivot.index), 1), minor=True)
    ax.grid(which='minor', color='white', linewidth=1.5)
    ax.tick_params(which='minor', size=0)
    q_lookup = sens_table[sens_table['modeled']].set_index(['Site', 'Adjustment'])['FDR_Q']
    for i, site in enumerate(pivot.index):
        for j, adj in enumerate(pivot.columns):
            q = q_lookup.get((site, adj), np.nan)
            if pd.notna(q) and q < 0.05:
                ax.scatter([j], [i], marker='o', color='white', s=25, edgecolors='none')
    cbar = fig.colorbar(im, ax=ax, orientation='horizontal', pad=0.35, shrink=0.6)
    cbar.set_label('log2(OR)')
    fig_path = finalize_figure(fig, output_dir, 'supp_fig3_LMS_site_sensitivity_heatmap.png', dpi, overwrite)
    return (fig_path, sens_table)

def supp_fig4_paired_primary_met(raw: pd.DataFrame, output_dir: Path, dpi: int, overwrite: bool) -> Tuple[Optional[Path], Optional[pd.DataFrame]]:
    lms = raw[raw['Cancer Type Detailed'] == 'Leiomyosarcoma'].copy()
    by_patient = lms.groupby('Patient ID')['Sample Type'].apply(set)
    eligible_patients = by_patient[by_patient.apply(lambda s: 'Primary' in s and 'Metastasis' in s)].index.tolist()
    if len(eligible_patients) < 3:
        logger.warning('Fewer than 3 patients with paired primary+metastasis samples; skipping Supplementary Figure 4.')
        return (None, None)
    pairs = []
    for pid in eligible_patients:
        pdata = lms[lms['Patient ID'] == pid]
        prim = pdata[pdata['Sample Type'] == 'Primary'].iloc[0]
        met = pdata[pdata['Sample Type'] == 'Metastasis'].iloc[0]
        pairs.append({'Patient ID': pid, 'TMB_primary': prim['TMB Score'], 'TMB_metastasis': met['TMB Score'], 'FGA_primary': prim['Fraction Genome Altered'], 'FGA_metastasis': met['Fraction Genome Altered'], 'MutCount_primary': prim['Mutation Count'], 'MutCount_metastasis': met['Mutation Count']})
    paired_df = pd.DataFrame(pairs)
    fig, axes = plt.subplots(1, 3, figsize=(14, 5))
    for ax, letter, var, label in zip(axes, ['a', 'b', 'c'], ['TMB', 'FGA', 'MutCount'], ['TMB (mutations per Mb)', 'FGA', 'Mutation count']):
        panel_label(ax, letter)
        prim_col, met_col = (f'{var}_primary', f'{var}_metastasis')
        sub = paired_df.dropna(subset=[prim_col, met_col])
        for _, row in sub.iterrows():
            ax.plot([0, 1], [row[prim_col], row[met_col]], color='grey', alpha=0.5, linewidth=1, zorder=1)
        ax.scatter([0] * len(sub), sub[prim_col], color=COLOR_PRIMARY, s=45, zorder=2)
        ax.scatter([1] * len(sub), sub[met_col], color=COLOR_METASTASIS, s=45, zorder=2)
        ax.set_xticks([0, 1])
        ax.set_xticklabels(['Primary', 'Metastasis'])
        ax.set_ylabel(label)
        if len(sub) >= 3:
            _, p = wilcoxon(sub[prim_col], sub[met_col])
            ax.text(0.5, 1.02, f'Wilcoxon P = {p:.3g} (n = {len(sub)} pairs)', transform=ax.transAxes, ha='center', fontsize=9)
        else:
            ax.text(0.5, 1.02, f'n = {len(sub)} pairs -- too few to test', transform=ax.transAxes, ha='center', fontsize=9)
        style_axis(ax)
    handles = [mlines.Line2D([], [], color=COLOR_PRIMARY, marker='o', linestyle='', label='Primary'), mlines.Line2D([], [], color=COLOR_METASTASIS, marker='o', linestyle='', label='Metastasis')]
    bottom_legend(fig, handles, [h.get_label() for h in handles])
    fig_path = finalize_figure(fig, output_dir, 'supp_fig4_LMS_paired_primary_metastasis.png', dpi, overwrite, rect=(0, 0.06, 1, 0.96))
    return (fig_path, paired_df)

def supp_table1_extended_burden_model(cohort: pd.DataFrame) -> pd.DataFrame:
    extra = ['MET_ORIGIN_bin', 'PANEL_468_bin', 'NON_EUROPEAN_ANCESTRY_bin']
    result = site_burden_model(cohort, extra_covariates=extra)
    labels = {'HLA_LOH_bin': 'HLA-I loss of heterozygosity', 'TMB': 'TMB (per unit, mutations/Mb)', 'FGA': 'FGA (per unit)', 'AGE': 'Age (per year)', 'SEX_bin': 'Female sex', 'MET_ORIGIN_bin': 'Metastatic-origin specimen', 'PANEL_468_bin': 'IMPACT468 panel', 'NON_EUROPEAN_ANCESTRY_bin': 'Non-European genetic ancestry'}
    rows = []
    for term in result['terms']:
        rr, lo, hi, p = (result[f'{term}_RR'], result[f'{term}_RR_lo'], result[f'{term}_RR_hi'], result[f'{term}_p'])
        rows.append({'Predictor': labels.get(term, term), 'RR (95% CI)': f'{rr:.2f} ({lo:.2f}-{hi:.2f})', 'P': p, 'n': result['n']})
    return pd.DataFrame(rows)

def supp_table2_bone_not_modeled(cohort: pd.DataFrame, min_site_n: int) -> pd.DataFrame:
    n_bone = int(cohort['RECORDED_METASTATIC_SITES'].apply(lambda lst: 'Bone' in lst).sum())
    return pd.DataFrame([{'Site': 'Bone', 'N_positive': n_bone, 'N_total': len(cohort), 'Minimum_N_required_to_model': min_site_n, 'Status': 'NOT MODELED', 'Reason': f'Only {n_bone} of {len(cohort)} analysis-cohort patients have a recorded bone metastasis (below the pre-specified minimum of {min_site_n} positive patients). Fitting a logistic model here would produce an unstable, uninterpretable estimate; reporting only the raw count preserves integrity.'}])

def supp_table4_driver_interactions_not_producible() -> pd.DataFrame:
    return pd.DataFrame([{'Table': 'Supplementary Table 4 (driver-specific HLA-I LOH burden interactions)', 'Status': 'NOT PRODUCIBLE', 'Reason': 'This MSK-IMPACT leiomyosarcoma clinical export contains no per-gene mutation-call columns (no TP53/KRAS/EGFR or equivalent driver-alteration fields). Reproducing this table would require fabricating gene-level calls, which this pipeline will not do. If a genomics MAF/mutation file for this cohort becomes available, this table can be built from real per-gene calls.'}])

def supp_table5_survival_interactions(surv_cohort: pd.DataFrame) -> pd.DataFrame:
    df = surv_cohort.dropna(subset=['OS_TIME', 'OS_EVENT', 'HLA_LOH_bin', 'FGA', 'TMB', 'AGE', 'SEX_bin', 'N_RECORDED_METASTATIC_SITES']).copy()
    if len(df) < 20:
        return pd.DataFrame()
    interactions = {'HLA-I LOH x metastatic-site burden': 'N_RECORDED_METASTATIC_SITES', 'HLA-I LOH x FGA': 'FGA', 'HLA-I LOH x TMB': 'TMB'}
    rows = []
    for label, covar in interactions.items():
        cox_df = df[['OS_TIME', 'OS_EVENT', 'HLA_LOH_bin', 'FGA', 'TMB', 'AGE', 'SEX_bin', 'N_RECORDED_METASTATIC_SITES']].copy()
        cox_df['INTERACTION'] = cox_df['HLA_LOH_bin'] * cox_df[covar]
        try:
            cph = CoxPHFitter()
            cph.fit(cox_df, duration_col='OS_TIME', event_col='OS_EVENT', robust=True)
            s = cph.summary
            beta, lo_c, hi_c, p = (s.loc['INTERACTION', 'coef'], s.loc['INTERACTION', 'coef lower 95%'], s.loc['INTERACTION', 'coef upper 95%'], s.loc['INTERACTION', 'p'])
            rows.append({'Interaction': label, 'RHR (95% CI)': f'{np.exp(beta):.2f} ({np.exp(lo_c):.2f}-{np.exp(hi_c):.2f})', 'P': float(p), 'n': int(len(cox_df)), 'Events': int(cox_df['OS_EVENT'].sum())})
        except Exception as exc:
            logger.warning('Survival interaction model failed for %s: %s', label, exc)
            rows.append({'Interaction': label, 'RHR (95% CI)': 'NA', 'P': np.nan, 'n': int(len(cox_df)), 'Events': int(cox_df['OS_EVENT'].sum())})
    table = pd.DataFrame(rows)
    valid = table['P'].notna()
    table['FDR_Q'] = np.nan
    if valid.any():
        table.loc[valid, 'FDR_Q'] = multipletests(table.loc[valid, 'P'], method='fdr_bh')[1]
    return table

def main() -> None:
    args = parse_args()
    output_dir = Path(args.output_dir).resolve()
    ensure_dir(output_dir)
    logger.info('Starting LMS HLA-I LOH display-item pipeline (real-data only)')
    raw = load_raw(Path(args.input_tsv))
    index_samples, flow = build_patient_level_cohort(raw)
    cohort, flow = build_analysis_cohort(index_samples, flow)
    surv_cohort = build_survival_subset(cohort, flow)
    cohort = prep_model_columns(cohort)
    surv_cohort = prep_model_columns(surv_cohort)
    save_csv(build_table1(cohort), output_dir, 'LMS_table1_characteristics.csv', args.overwrite)
    table2, site_freq_table, site_model_table = build_table2(cohort, surv_cohort, args.min_site_n)
    save_csv(table2, output_dir, 'LMS_table2_hypothesis_tests.csv', args.overwrite)
    save_csv(site_freq_table, output_dir, 'LMS_metastatic_site_frequencies_ALL_SITES.csv', args.overwrite)
    if not site_model_table.empty:
        save_csv(site_model_table, output_dir, 'LMS_site_specific_logistic_models.csv', args.overwrite)
    save_csv(cohort.drop(columns=['RECORDED_METASTATIC_SITES']), output_dir, 'LMS_analysis_cohort.csv', args.overwrite)
    nb_result = site_burden_model(cohort)
    cph, cox_df = fit_cox(surv_cohort)
    cox_result = cox_summary_dict(cph, cox_df) if cph is not None else None
    fig1_cohort_and_sites(cohort, flow, site_freq_table, output_dir, args.dpi, args.overwrite)
    fig2_burden_boxplots(cohort, nb_result, output_dir, args.dpi, args.overwrite)
    fig3_survival(surv_cohort, cox_result, output_dir, args.dpi, args.overwrite)
    fig4_site_forest(site_model_table, output_dir, args.dpi, args.overwrite)
    supp_fig1_evaluability(index_samples, cohort, output_dir, args.dpi, args.overwrite)
    supp_fig2_survival_diagnostics(surv_cohort, output_dir, args.dpi, args.overwrite)
    site_freq_all = cohort['RECORDED_METASTATIC_SITES'].explode().value_counts()
    sites_for_sensitivity = site_freq_all[site_freq_all >= args.min_site_n].index.tolist()
    logger.info('Sites meeting min-N=%d for sensitivity analysis: %s', args.min_site_n, sites_for_sensitivity)
    _, sens_table = supp_fig3_and_table3_sensitivity(cohort, sites_for_sensitivity, output_dir, args.dpi, args.overwrite)
    save_csv(sens_table, output_dir, 'supp_LMS_table3_site_sensitivity.csv', args.overwrite)
    _, paired_df = supp_fig4_paired_primary_met(raw, output_dir, args.dpi, args.overwrite)
    if paired_df is not None:
        save_csv(paired_df, output_dir, 'supp_LMS_paired_primary_metastasis_data.csv', args.overwrite)
    save_csv(supp_table1_extended_burden_model(cohort), output_dir, 'supp_LMS_table1_extended_burden_model.csv', args.overwrite)
    save_csv(supp_table2_bone_not_modeled(cohort, args.min_site_n), output_dir, 'supp_LMS_table2_bone_not_modeled.csv', args.overwrite)
    save_csv(supp_table4_driver_interactions_not_producible(), output_dir, 'supp_LMS_table4_driver_interactions_NOT_PRODUCIBLE.csv', args.overwrite)
    table5 = supp_table5_survival_interactions(surv_cohort)
    if not table5.empty:
        save_csv(table5, output_dir, 'supp_LMS_table5_survival_interactions.csv', args.overwrite)
    metadata = {'program_version': PROGRAM_VERSION, 'input_file': str(args.input_tsv), 'min_site_n_to_model': args.min_site_n, 'cohort_flow': flow, 'sites_sensitivity_tested': sites_for_sensitivity, 'notes': ['All statistics are computed directly from the real MSK-IMPACT leiomyosarcoma clinical export. No per-gene driver mutation data exists in this file, so no driver-interaction analyses were attempted (see Supplementary Table 4).', f'Metastatic sites with fewer than {args.min_site_n} positive patients are reported as raw counts only (Figure 1 / Table 2) and are excluded from any regression/OR table.', 'Supplementary Table 2 (bone) is reported as NOT MODELED with the real raw count because only a handful of patients in this cohort have a recorded bone metastasis.', "Supplementary Figure/Table 3 could only be run for the 'all mapped' population: in this dataset, 'Metastatic Site' is populated almost exclusively for the sequenced specimen itself, so the target-site-biopsy-excluded and primary-biopsy-only populations from the reference paper have ~0 positive cases for Lung/Liver and are documented as not analyzable rather than modeled."]}
    save_json(metadata, output_dir, 'LMS_run_metadata.json', args.overwrite)
    logger.info('Done. Analysis cohort n=%d, survival cohort n=%d. Outputs: %s', len(cohort), len(surv_cohort), output_dir)
if __name__ == '__main__':
    main()
