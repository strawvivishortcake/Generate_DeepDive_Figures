def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)

def resolve_path(output_dir: Path, filename: str, overwrite: bool) -> Path:
    path = output_dir / filename
    if path.exists() and (not overwrite):
        raise FileExistsError(f'Refusing to overwrite {path}. Re-run with --overwrite.')
    return path

def save_csv(df: pd.DataFrame, output_dir: Path, filename: str, overwrite: bool) -> Path:
    path = resolve_path(output_dir, filename, overwrite)
    df.to_csv(path, index=False)
    logger.info('Saved %s', path)
    return path

def save_json(data: Dict, output_dir: Path, filename: str, overwrite: bool) -> Path:
    path = resolve_path(output_dir, filename, overwrite)
    with path.open('w') as f:
        json.dump(data, f, indent=2, sort_keys=True, default=str)
    logger.info('Saved %s', path)
    return path

def save_fig(fig, output_dir: Path, filename: str, dpi: int, overwrite: bool) -> Path:
    path = resolve_path(output_dir, filename, overwrite)
    fig.savefig(path, dpi=dpi, bbox_inches='tight')
    plt.close(fig)
    logger.info('Saved %s', path)
    return path

def smd_continuous(x1: pd.Series, x2: pd.Series) -> float:
    x1 = x1.dropna().astype(float)
    x2 = x2.dropna().astype(float)
    if len(x1) < 2 or len(x2) < 2:
        return np.nan
    pooled_sd = np.sqrt((x1.var(ddof=1) + x2.var(ddof=1)) / 2.0)
    if pooled_sd <= 1e-12:
        return np.nan
    return float(abs(x1.mean() - x2.mean()) / pooled_sd)

def smd_binary(p1: float, n1: int, p2: float, n2: int) -> float:
    if n1 < 2 or n2 < 2 or np.isnan(p1) or np.isnan(p2):
        return np.nan
    pooled_var = (p1 * (1 - p1) + p2 * (1 - p2)) / 2.0
    if pooled_var <= 1e-12:
        return np.nan
    return float(abs(p1 - p2) / np.sqrt(pooled_var))

def median_iqr(series: pd.Series, ndigits: int=1) -> str:
    s = series.dropna().astype(float)
    if s.empty:
        return 'NA'
    q1, med, q3 = s.quantile([0.25, 0.5, 0.75])
    return f'{med:.{ndigits}f} ({q1:.{ndigits}f}-{q3:.{ndigits}f})'

def n_pct(count: int, total: int, ndigits: int=1) -> str:
    if total == 0:
        return 'NA'
    return f'{count} ({100 * count / total:.{ndigits}f}%)'

def wilson_ci(count: int, total: int) -> Tuple[float, float, float]:
    if total == 0:
        return (np.nan, np.nan, np.nan)
    prop = count / total
    lo, hi = proportion_confint(count, total, method='wilson')
    return (prop, lo, hi)

def load_raw(path: Path) -> pd.DataFrame:
    raw = pd.read_csv(path, sep='\t')
    cancer_types = raw['Cancer Type Detailed'].dropna().unique().tolist()
    logger.info('Loaded %d sample rows. Cancer Type Detailed values present: %s', len(raw), cancer_types)
    if not any(('Leiomyosarcoma' in str(v) for v in cancer_types)):
        raise ValueError("No 'Leiomyosarcoma' records found in 'Cancer Type Detailed'. This pipeline expects a leiomyosarcoma clinical export.")
    return raw

def _sample_order(sample_id: str) -> int:
    match = re.search('-T0?(\\d+)-', str(sample_id))
    return int(match.group(1)) if match else 99

def build_patient_level_cohort(raw: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, int]]:
    df = raw[raw['Cancer Type Detailed'] == 'Leiomyosarcoma'].copy()
    flow: Dict[str, int] = {'n_sample_rows_LMS': int(len(df))}
    df['_order'] = df['Sample ID'].apply(_sample_order)
    site_agg = df.groupby('Patient ID')['Metastatic Site'].apply(lambda s: sorted(set((v for v in s.dropna().astype(str))))).rename('RECORDED_METASTATIC_SITES')
    df_sorted = df.sort_values(['Patient ID', '_order'])
    index_samples = df_sorted.groupby('Patient ID', as_index=False).first()
    index_samples = index_samples.merge(site_agg, on='Patient ID', how='left')
    index_samples['N_RECORDED_METASTATIC_SITES'] = index_samples['RECORDED_METASTATIC_SITES'].apply(len)
    index_samples['HAS_RECORDED_METASTATIC_SITE'] = index_samples['N_RECORDED_METASTATIC_SITES'] > 0
    flow['n_patients_LMS'] = int(len(index_samples))
    logger.info('Collapsed to %d unique LMS patients (index sample = first sequenced).', len(index_samples))
    return (index_samples, flow)

def annotate_hla_loh(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    loh_cols = ['HLA-A Allele 1 LOH Status', 'HLA-A Allele 2 LOH Status', 'HLA-B Allele 1 LOH Status', 'HLA-B Allele 2 LOH Status', 'HLA-C Allele 1 LOH Status', 'HLA-C Allele 2 LOH Status']
    evaluable = df['HLA Genotype Available'].fillna(False) & df[loh_cols].notna().all(axis=1)
    any_loss = (df[loh_cols] == 'Loss').any(axis=1)
    hla_status = pd.Series(np.nan, index=df.index, dtype=object)
    hla_status[evaluable & any_loss] = 'HLA-I LOH'
    hla_status[evaluable & ~any_loss] = 'HLA-I intact'
    df['HLA_I_LOH_STATUS'] = hla_status
    df['HLA_I_EVALUABLE'] = evaluable
    return df

def build_analysis_cohort(index_samples: pd.DataFrame, flow: Dict[str, int]) -> Tuple[pd.DataFrame, Dict[str, int]]:
    df = index_samples.copy()
    n0 = len(df)
    df = df[df['FACETS QC'] == 'Pass'].copy()
    flow['dropped_facets_qc_fail_or_missing'] = int(n0 - len(df))
    df = annotate_hla_loh(df)
    n1 = len(df)
    df = df[df['HLA_I_EVALUABLE']].copy()
    flow['dropped_hla_not_evaluable'] = int(n1 - len(df))
    n2 = len(df)
    base_covariates = ['Age at Diagnosis', 'Sex', 'Fraction Genome Altered', 'TMB Score']
    df = df.dropna(subset=base_covariates).copy()
    flow['dropped_missing_base_covariates'] = int(n2 - len(df))
    flow['n_analysis_cohort'] = int(len(df))
    logger.info('Analysis cohort after QC/evaluability/covariate filters: n=%d', len(df))
    df = df.rename(columns={'Age at Diagnosis': 'AGE', 'Sex': 'SEX', 'Fraction Genome Altered': 'FGA', 'TMB Score': 'TMB', 'Mutation Count': 'MUTATION_COUNT', 'MSI Score': 'MSI_SCORE', 'MSI Type': 'MSI_TYPE', 'Sample Type': 'SAMPLE_TYPE', 'Disease Status': 'DISEASE_STATUS', 'Gene Panel': 'GENE_PANEL', 'Overall Survival (Months)': 'OS_TIME', 'Overall Survival Status': 'OS_STATUS_RAW', 'Genetic Ancestry': 'GENETIC_ANCESTRY'})
    df['OS_EVENT'] = df['OS_STATUS_RAW'].apply(lambda v: 1 if 'DECEASED' in str(v) else 0 if 'LIVING' in str(v) else np.nan)
    df['OS_TIME'] = pd.to_numeric(df['OS_TIME'], errors='coerce')
    return (df, flow)

def build_survival_subset(cohort: pd.DataFrame, flow: Dict[str, int]) -> pd.DataFrame:
    n0 = len(cohort)
    surv = cohort.dropna(subset=['OS_TIME', 'OS_EVENT']).copy()
    surv = surv[surv['OS_TIME'] > 0].copy()
    flow['dropped_missing_or_invalid_survival'] = int(n0 - len(surv))
    flow['n_survival_cohort'] = int(len(surv))
    return surv

def prep_model_columns(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df['HLA_LOH_bin'] = (df['HLA_I_LOH_STATUS'] == 'HLA-I LOH').astype(int)
    df['SEX_bin'] = (df['SEX'] == 'Female').astype(int)
    df['PANEL_468_bin'] = (df['GENE_PANEL'] == 'IMPACT468').astype(int)
    df['MET_ORIGIN_bin'] = (df['SAMPLE_TYPE'] == 'Metastasis').astype(int)
    european = {'nonASJ-EUR', 'ASJ-EUR'}
    df['NON_EUROPEAN_ANCESTRY_bin'] = (~df['GENETIC_ANCESTRY'].isin(european)).astype(int)
    return df

def build_table1(cohort: pd.DataFrame) -> pd.DataFrame:
    groups = {'Overall': cohort, 'HLA-I intact': cohort[cohort['HLA_I_LOH_STATUS'] == 'HLA-I intact'], 'HLA-I LOH': cohort[cohort['HLA_I_LOH_STATUS'] == 'HLA-I LOH']}
    intact, loh = (groups['HLA-I intact'], groups['HLA-I LOH'])
    rows: List[Dict] = []

    def add_continuous_row(label: str, col: str):
        row = {'Characteristic': label}
        for gname, gdf in groups.items():
            row[gname] = median_iqr(gdf[col])
        row['SMD'] = round(smd_continuous(intact[col], loh[col]), 2) if len(intact) and len(loh) else np.nan
        rows.append(row)

    def add_binary_row(label: str, mask_fn):
        row = {'Characteristic': label}
        for gname, gdf in groups.items():
            row[gname] = n_pct(int(mask_fn(gdf).sum()), len(gdf))
        p_intact = mask_fn(intact).sum() / len(intact) if len(intact) else np.nan
        p_loh = mask_fn(loh).sum() / len(loh) if len(loh) else np.nan
        row['SMD'] = round(smd_binary(p_intact, len(intact), p_loh, len(loh)), 2) if len(intact) and len(loh) else np.nan
        rows.append(row)
    rows.append({'Characteristic': 'Patients, n', 'Overall': len(groups['Overall']), 'HLA-I intact': len(intact), 'HLA-I LOH': len(loh), 'SMD': '-'})
    add_continuous_row('Age at diagnosis, years', 'AGE')
    add_continuous_row('TMB, mutations/Mb', 'TMB')
    add_continuous_row('FGA', 'FGA')
    add_continuous_row('Mutation count', 'MUTATION_COUNT')
    add_continuous_row('Recorded metastatic sites, n', 'N_RECORDED_METASTATIC_SITES')
    add_binary_row('Female sex', lambda d: d['SEX'] == 'Female')
    add_binary_row('Metastatic-origin specimen', lambda d: d['SAMPLE_TYPE'] == 'Metastasis')
    add_binary_row('IMPACT468 panel', lambda d: d['GENE_PANEL'] == 'IMPACT468')
    add_binary_row('Any recorded metastatic site', lambda d: d['HAS_RECORDED_METASTATIC_SITE'])
    add_binary_row('MSI-instable (of typed)', lambda d: d['MSI_TYPE'] == 'Instable')
    return pd.DataFrame(rows)

def continuous_group_test(cohort: pd.DataFrame, col: str) -> Tuple[float, float]:
    intact = cohort.loc[cohort['HLA_I_LOH_STATUS'] == 'HLA-I intact', col].dropna()
    loh = cohort.loc[cohort['HLA_I_LOH_STATUS'] == 'HLA-I LOH', col].dropna()
    if len(intact) < 2 or len(loh) < 2:
        return (np.nan, np.nan)
    stat, p = mannwhitneyu(intact, loh, alternative='two-sided')
    return (float(stat), float(p))

def site_burden_model(cohort: pd.DataFrame, extra_covariates: Optional[List[str]]=None) -> Optional[Dict]:
    covariates = ['FGA', 'TMB', 'AGE', 'SEX_bin'] + (extra_covariates or [])
    model_df = cohort.dropna(subset=['N_RECORDED_METASTATIC_SITES', 'HLA_LOH_bin'] + covariates).copy()
    formula = 'N_RECORDED_METASTATIC_SITES ~ HLA_LOH_bin + ' + ' + '.join(covariates)
    fitted, model_family = (None, None)
    try:
        nb_model = smf.negativebinomial(formula, data=model_df).fit(disp=False, maxiter=300)
        if np.isfinite(nb_model.bse).all():
            fitted, model_family = (nb_model, 'negative_binomial')
        else:
            logger.warning('Negative-binomial model produced non-finite SEs (near-zero overdispersion for this variable); falling back to a Poisson GLM with HC3-robust SE.')
    except Exception as exc:
        logger.warning('Negative-binomial site-burden model failed to fit (%s); falling back to Poisson/HC3.', exc)
    if fitted is None:
        try:
            fitted = smf.glm(formula, data=model_df, family=sm.families.Poisson()).fit(cov_type='HC3')
            model_family = 'poisson_HC3_robust'
        except Exception as exc:
            logger.warning('Poisson fallback model also failed to fit: %s', exc)
            return None
    result = {'n': int(len(model_df)), 'model_family': model_family, 'terms': ['HLA_LOH_bin'] + covariates}
    for term in result['terms']:
        beta, se, p = (fitted.params.get(term, np.nan), fitted.bse.get(term, np.nan), fitted.pvalues.get(term, np.nan))
        result[f'{term}_RR'] = float(np.exp(beta))
        result[f'{term}_RR_lo'] = float(np.exp(beta - 1.96 * se))
        result[f'{term}_RR_hi'] = float(np.exp(beta + 1.96 * se))
        result[f'{term}_p'] = float(p)
    return result

def fit_cox(surv_cohort: pd.DataFrame, extra_covariates: Optional[List[str]]=None) -> Tuple[Optional[CoxPHFitter], Optional[pd.DataFrame]]:
    covariates = ['FGA', 'TMB', 'AGE', 'SEX_bin'] + (extra_covariates or [])
    df = surv_cohort.dropna(subset=['OS_TIME', 'OS_EVENT', 'HLA_LOH_bin'] + covariates).copy()
    if len(df) < 20:
        return (None, None)
    cox_df = df[['OS_TIME', 'OS_EVENT', 'HLA_LOH_bin'] + covariates].copy()
    cph = CoxPHFitter()
    cph.fit(cox_df, duration_col='OS_TIME', event_col='OS_EVENT', robust=True)
    return (cph, cox_df)

def cox_summary_dict(cph: CoxPHFitter, cox_df: pd.DataFrame, term: str='HLA_LOH_bin') -> Dict:
    s = cph.summary
    return {'n': int(len(cox_df)), 'n_events': int(cox_df['OS_EVENT'].sum()), 'HR': float(np.exp(s.loc[term, 'coef'])), 'HR_lo': float(np.exp(s.loc[term, 'coef lower 95%'])), 'HR_hi': float(np.exp(s.loc[term, 'coef upper 95%'])), 'p': float(s.loc[term, 'p'])}

def site_specific_logistic_models(cohort: pd.DataFrame, sites: List[str], min_n: int) -> pd.DataFrame:
    rows = []
    model_df = cohort.dropna(subset=['HLA_LOH_bin', 'FGA', 'TMB', 'AGE', 'SEX_bin']).copy()
    for site in sites:
        model_df[f'has_{site}'] = model_df['RECORDED_METASTATIC_SITES'].apply(lambda lst: site in lst)
        n_pos = int(model_df[f'has_{site}'].sum())
        row = {'SITE': site, 'N_POSITIVE': n_pos, 'N_TOTAL': int(len(model_df))}
        if n_pos < min_n:
            row.update({'MODELED': False, 'OR': np.nan, 'OR_lo': np.nan, 'OR_hi': np.nan, 'P': np.nan})
            rows.append(row)
            continue
        try:
            logit = smf.glm(f'has_{site} ~ HLA_LOH_bin + FGA + TMB + AGE + SEX_bin', data=model_df, family=sm.families.Binomial()).fit(cov_type='HC3')
            beta, se, p = (logit.params['HLA_LOH_bin'], logit.bse['HLA_LOH_bin'], logit.pvalues['HLA_LOH_bin'])
            row.update({'MODELED': True, 'OR': float(np.exp(beta)), 'OR_lo': float(np.exp(beta - 1.96 * se)), 'OR_hi': float(np.exp(beta + 1.96 * se)), 'P': float(p)})
        except Exception as exc:
            logger.warning("Logistic model for site '%s' failed: %s", site, exc)
            row.update({'MODELED': False, 'OR': np.nan, 'OR_lo': np.nan, 'OR_hi': np.nan, 'P': np.nan})
        rows.append(row)
    result = pd.DataFrame(rows)
    modeled = result['MODELED']
    result['FDR_Q'] = np.nan
    if modeled.any():
        result.loc[modeled, 'FDR_Q'] = multipletests(result.loc[modeled, 'P'], method='fdr_bh')[1]
    return result

def build_table2(cohort: pd.DataFrame, surv_cohort: pd.DataFrame, min_site_n: int) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    rows = []
    for col, name in [('FGA', 'FGA'), ('TMB', 'TMB'), ('N_RECORDED_METASTATIC_SITES', 'Recorded site count')]:
        _, p = continuous_group_test(cohort, col)
        domain = 'Metastatic-site burden' if 'site' in name.lower() else 'Genomic burden'
        rows.append({'Domain': domain, 'Estimand': f'{name} (HLA-I LOH vs intact)', 'Test': 'Mann-Whitney U', 'P': p, 'n': len(cohort)})
    nb = site_burden_model(cohort)
    if nb is not None:
        model_label = 'Negative-binomial' if nb['model_family'] == 'negative_binomial' else 'Poisson (HC3-robust; NB did not converge)'
        rows.append({'Domain': 'Metastatic-site burden (adjusted)', 'Estimand': 'HLA-I LOH', 'Test': f'{model_label}, RR (95% CI)', 'Effect': f'RR {nb['HLA_LOH_bin_RR']:.2f} ({nb['HLA_LOH_bin_RR_lo']:.2f}-{nb['HLA_LOH_bin_RR_hi']:.2f})', 'P': nb['HLA_LOH_bin_p'], 'n': nb['n']})
    intact = surv_cohort[surv_cohort['HLA_I_LOH_STATUS'] == 'HLA-I intact']
    loh = surv_cohort[surv_cohort['HLA_I_LOH_STATUS'] == 'HLA-I LOH']
    if len(intact) >= 5 and len(loh) >= 5:
        lr = logrank_test(intact['OS_TIME'], loh['OS_TIME'], event_observed_A=intact['OS_EVENT'], event_observed_B=loh['OS_EVENT'])
        rows.append({'Domain': 'Overall survival', 'Estimand': 'HLA-I LOH (unadjusted log-rank)', 'Test': 'Log-rank', 'P': float(lr.p_value), 'n': int(len(intact) + len(loh))})
    cph, cox_df = fit_cox(surv_cohort)
    cox_result = cox_summary_dict(cph, cox_df) if cph is not None else None
    if cox_result is not None:
        rows.append({'Domain': 'Overall survival (adjusted)', 'Estimand': 'HLA-I LOH', 'Test': 'Cox PH, robust SE, HR (95% CI)', 'Effect': f'HR {cox_result['HR']:.2f} ({cox_result['HR_lo']:.2f}-{cox_result['HR_hi']:.2f})', 'P': cox_result['p'], 'n': cox_result['n']})
    table2 = pd.DataFrame(rows)
    table2['P'] = pd.to_numeric(table2['P'], errors='coerce')
    all_sites = sorted(set((s for lst in cohort['RECORDED_METASTATIC_SITES'] for s in lst)))
    n_with_data = len(cohort)
    site_rows = []
    for site in all_sites:
        count = int(cohort['RECORDED_METASTATIC_SITES'].apply(lambda lst: site in lst).sum())
        prop, lo, hi = wilson_ci(count, n_with_data)
        site_rows.append({'SITE': site, 'N': count, 'N_TOTAL': n_with_data, 'PERCENT': round(prop * 100, 1) if not np.isnan(prop) else np.nan, 'WILSON_CI_LOW': round(lo * 100, 1) if not np.isnan(lo) else np.nan, 'WILSON_CI_HIGH': round(hi * 100, 1) if not np.isnan(hi) else np.nan, 'MODELED': count >= min_site_n})
    site_freq_table = pd.DataFrame(site_rows).sort_values('N', ascending=False).reset_index(drop=True)
    sites_to_model = site_freq_table.loc[site_freq_table['MODELED'], 'SITE'].tolist()
    site_model_table = site_specific_logistic_models(cohort, sites_to_model, min_site_n) if sites_to_model else pd.DataFrame()
    return (table2, site_freq_table, site_model_table)

